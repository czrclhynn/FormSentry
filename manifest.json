{
  "manifest_version": 3,
  "name": "Google Forms Anti-Cheating Monitor",
  "version": "0.1.0",
  "description": "Browser-level monitoring layer for teacher-approved Google Forms exams. Active only during an approved exam.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://docs.google.com/forms/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Anti-Cheating Monitor" },
  "options_page": "options.html"
}
